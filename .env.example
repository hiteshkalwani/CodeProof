# Copy to .env. With LLM_PROVIDER=fake everything runs without an API key (scripted model, real sandbox).
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# fake | openai
LLM_PROVIDER=fake
OPENAI_API_KEY=
LLM_CODE_MODEL=gpt-4o
LLM_TEST_MODEL=gpt-4o-mini
LLM_RATE_LIMIT=20/min

SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY=128m
MAX_REPAIR_ATTEMPTS=3
